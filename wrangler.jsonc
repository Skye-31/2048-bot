{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "2048-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": [],
	"workers_dev": false,
	"route": {
		"custom_domain": true,
		"zone_name": "skye-does.dev",
		"pattern": "2048-bot.skye-does.dev",
	},
	"secrets": {
		"required": ["BOT_ID", "BOT_PUBLIC_KEY", "BOT_TOKEN"],
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
}
