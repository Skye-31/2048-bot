{
	"name": "2048-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "oxfmt --check && tsc --noEmit",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "oxfmt --write",
		"set-commands": "node register-commands.ts",
		"start": "wrangler dev",
		"test": "vitest",
		"tunnel": "cloudflared tunnel --url localhost:8787 --name 2048bot-dev"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.6",
		"discord-api-types": "^0.38.50",
		"dotenv": "^17.4.2",
		"oxfmt": "^0.59.0",
		"typescript": "^7.0.2",
		"vitest": "4.1.10",
		"wrangler": "^4.112.0"
	}
}
